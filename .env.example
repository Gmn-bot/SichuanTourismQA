# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# 火山方舟 OpenAI 兼容。LLM_API_KEY 留空则只用图谱模板回答
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
