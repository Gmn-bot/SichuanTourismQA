# Web（浏览器请打开 http://127.0.0.1:5000）
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_LEVEL=INFO

# 检索
RETRIEVE_TOP_K=8
NEAR_LIMIT=3
ENABLE_TEXT2CYPHER=false